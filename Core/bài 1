#include "stm32f10x.h"
/* RCC_APB2ENR : 0x40021018
   GPIOC_CRL   : 0x40011000
   GPIOC_ODR   : 0x4001100C
   GPIOC_BSRR  : 0x40011010
   GPIOC_BRR   : 0x40011014
*/
/*  Vì truy cập thanh ghi bằng struct đã định nghĩa sẵn trong CMSIS nên không cần định nghĩa mấy thanh ghi trên,
    chỉ cần tìm vị trí bit của PC6 và chế độ mà đề bài yêu cầu.*/
// nếu sử dụng thanh ghi trên thì cần phải định nghĩa
#define RCC_APB2ENR   (*(volatile unsigned int*)0x40021018)
#define GPIOC_CRL     (*(volatile unsigned int*)0x40011000)
#define GPIOC_ODR     (*(volatile unsigned int*)0x4001100C)

void GPIO_Init(void) {
	// SETUP CLOCK FOR GPIOC (BIT 4 IN RCC_APB2NER)
   /* Bit 4: I/O port clock enable
             0:disabled
			 1:enabled
	 use "OR" operator to set up clock for GPIOC
     '1' shift left 4 bits */
	RCC_APB2ENR |= (1 << 4);
	
	// PC6 is pin 6, located in CRL (pins 0-7)
	//Bit positions: MODE6 = bits 24-45, CNF6 = bits 26-27
	
	//Clear previous configuration bits for PC6
	GPIOC_CRL &= ~(0xF << 24); // Clear 4 bits MODE6 and CNF6
	
	//PC6 configuration is output push-pull, speed 10MHz
	//MODE6 = 01(output mode, max speed 10MHz)
	//CNF6 = 00 (General purpose output push-pull)
	GPIOC_CRL |= (0x1 << 24); //set MODE6[1:0] =01
	GPIOC_CRL &= ~(0x1 << 26); //set CNF6[1:0] = 00
}

void LED_ON(void){
	// Clear bit 6 trong ODR
	GPIOC_ODR &= ~(1 << 6);
	
	//Or use BRR to reset bit
	//GPIOC_BRR = (1 << 6); PC6 is pin 6 --> bit 6
}

void LED_OFF(void){
	// Set bit 6 in ODR 
	GPIOC_ODR |= (1 << 6);
	
	// Use BSRR to set bit
	//GPIOC_BSRR = (1 << 6);
}
int main(void){
	GPIO_Init();
	while(1){
		LED_ON();
		//LED_OFF();
	}
}




