#include "stm32f10x.h"

#define RCC_APB2ENR   (*(volatile unsigned int*)0x40021018)
#define GPIOC_CRL     (*(volatile unsigned int*)0x40011000)
#define GPIOC_ODR     (*(volatile unsigned int*)0x4001100C)

void GPIO_Init(void) {
	// SETUP CLOCK FOR GPIOC (BIT 4 IN RCC_APB2NER)
	RCC_APB2ENR |= (1 << 4);
	
	// PC6 is pin 6, located in CRL (pins 0-7)
	//Bit positions: MODE6 = bits 24-45, CNF6 = bits 26-27
	
	//Clear previous configuration bits for PC6
	GPIOC_CRL &= ~(0xF << 24); // Clear 4 bits MODE6 and CNF6
	
	//PC6 configuration is output push-pull, speed 10MHz
	//MODE6 = 01(output mode, max speed 10MHz)
	//CNF6 = 00 (General purpose output push-pull)
	GPIOC_CRL |= (0x1 << 24); //set MODE6[1:0] =01
	GPIOC_CRL &= ~(0x1 << 26); //set CNF6[1:0] = 00
}

void LED_OFF(void){
	// Set bit 6 in ODR 
	//GPIOC_ODR |= (1 << 6);
	
	// Use BSRR to set bit
	 GPIOC_BSRR = (1 << 6);
}

void LED_ON(void){
	// Clear bit 6 trong ODR
	//GPIOC_ODR &= ~(1 << 6);
	
	//Or use BRR to reset bit
	 GPIOC_BRR = (1 << 6);
}

void delay(volatile unsigned int time) {
    for (volatile unsigned int i = 0; i < time; i++);
}
int main(void){
	GPIO_Init();
 //LED nháy
	while(1){
		LED_ON();
		delay(500000);
		LED_OFF();
		delay(500000);
	}
}
